# AWS Billing Alert Terraform Configuration Example
# Copy this file to terraform.tfvars and customize for your environment

# AWS Region where billing resources will be deployed
# IMPORTANT: CloudWatch Billing metrics ('EstimatedCharges') are ONLY available in us-east-1.
aws_region = "us-east-1"

# Billing thresholds in USD (creates alarms for each threshold)
alert_thresholds = [100, 150, 200]

# AWS Services to monitor individually (e.g. ["AmazonEC2", "AmazonRDS"]). Set to [] to disable.
services_to_monitor = ["AmazonEC2"]

# Email addresses to receive billing alerts
# NOTE: Recipients will receive an AWS SNS subscription confirmation email that must be clicked.
email_endpoints = [
  "your-email@example.com",
  "team@example.com"
]

# Currency for billing alerts (3-letter ISO code)
currency = "USD"

# Evaluation period in seconds (21600 = 6 hours, 86400 = 24 hours)
alarm_period = 21600

# Send recovery notifications when charges drop below threshold
enable_ok_actions = true

# Create an SQS queue subscribed to SNS topic for downstream processing/automation
enable_sqs_endpoint = true

# Environment tag for resource identification
environment_tag = "Production"

# Additional custom tags
tags = {
  Project   = "CostOptimization"
  ManagedBy = "Terraform"
}

# SNS topic name
sns_topic_name = "billing-alert"
